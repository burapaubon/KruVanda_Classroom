function adminPlan_(q) {
  const target = enum_(q.target, [
    "courses",
    "groups",
    "students",
    "work",
    "system",
    "sessions",
  ]);
  const mode = enum_(
    q.mode,
    target === "sessions"
      ? ["expired", "logoutStudents"]
      : target === "system"
        ? ["reset"]
        : target === "work"
          ? ["clearWork"]
          : ["active", "inactive", "delete"],
  );
  const table = { courses: "Courses", groups: "Groups", students: "Students" }[
    target
  ];
  const ids = table
    ? q.ids === "all"
      ? rows_(table).map((r) => r.id)
      : Array.isArray(q.ids)
        ? [...new Set(q.ids)]
        : []
    : [];
  if (table && !ids.length) throw Error("เลือกข้อมูลอย่างน้อยหนึ่งรายการ");
  if (table && ids.some((id) => !rows_(table).some((r) => r.id === id)))
    throw Error("มีรายการที่ถูกลบไปแล้ว กรุณาโหลดข้อมูลล่าสุด");
  if (target === "sessions") {
    const teachers = new Set(
      rows_("Users")
        .filter((u) => u.role === "teacher")
        .map((u) => u.id),
    );
    const sessions = rows_("Sessions").filter((s) =>
      mode === "expired"
        ? Number(s.expiresAt) <= Date.now()
        : !teachers.has(s.userId),
    );
    return {
      keys: [],
      sessionIds: sessions.map((s) => s.id),
      count: sessions.length,
      labels: [],
      desired: {},
    };
  }
  const keys =
    mode === "reset"
      ? ADMIN_TABLES.slice()
      : table && mode !== "delete"
        ? target === "students"
          ? ["Students", "Users"]
          : [table]
        : target === "work"
          ? ["Submissions", "History", "Progress", "Runs"]
          : target === "courses"
            ? [
              "Courses",
              "Offerings",
              "Enrollments",
              "Chapters",
              "Materials",
              "Activities",
              "Submissions",
              "History",
              "Progress",
              "Runs",
            ]
            : [
              "Groups",
              "Students",
              "Users",
              "Enrollments",
              "Submissions",
              "History",
              "Progress",
              "Runs",
              "Profiles",
            ];
  const before = adminState_(keys),
    desired = {};
  keys.forEach(
    (k) => (desired[k] = before[k].map((r) => Object.assign({}, r))),
  );
  const selected = new Set(ids),
    labels = table
      ? rows_(table)
        .filter((r) => selected.has(r.id))
        .map((r) => r.fullName || r.name)
      : [];
  if (mode === "reset") {
    const teachers = new Set(
      before.Users.filter((u) => u.role === "teacher").map((u) => u.id),
    );
    keys.forEach(
      (k) =>
      (desired[k] =
        k === "Users"
          ? before[k].filter((u) => teachers.has(u.id))
          : k === "Profiles"
            ? before[k].filter((p) => teachers.has(p.id))
            : []),
    );
  } else if (mode === "active" || mode === "inactive") {
    const status =
      target === "courses" && mode === "inactive" ? "closed" : mode;
    desired[table].forEach((r) => {
      if (selected.has(r.id)) r.status = status;
    });
    if (target === "students")
      desired.Users.forEach((r) => {
        if (selected.has(r.id)) {
          r.status = status;
          r.version = Number(r.version || 0) + 1;
        }
      });
  } else {
    const students = new Set(
      target === "students"
        ? ids
        : target === "groups"
          ? before.Students.filter((s) => selected.has(s.groupId)).map(
            (s) => s.id,
          )
          : [],
    );
    const offerings = new Set(
      target === "courses"
        ? before.Offerings.filter((o) => selected.has(o.courseId)).map(
          (o) => o.id,
        )
        : q.courseId
          ? rows_("Offerings")
            .filter((o) => o.courseId === q.courseId)
            .map((o) => o.id)
          : [],
    );
    if (target === "work") {
      if (q.courseId) get_("Courses", q.courseId);
      if (q.groupId) get_("Groups", q.groupId);
      if (q.studentId) get_("Students", q.studentId);
      if (q.activityId) get_("Activities", q.activityId);
    }
    const groupStudents = new Set(
      target === "work" && q.groupId
        ? rows_("Students")
          .filter((s) => s.groupId === q.groupId)
          .map((s) => s.id)
        : [],
    );
    const enrollGroups = new Set(
      target === "work" && q.groupId
        ? rows_("Enrollments")
          .filter((e) => e.groupId === q.groupId)
          .map((e) => e.offeringId + ":" + e.studentId)
        : [],
    );
    const chapters = new Set(
      target === "courses"
        ? before.Chapters.filter((c) => selected.has(c.courseId)).map(
          (c) => c.id,
        )
        : [],
    );
    const activities = new Set(
      target === "courses"
        ? before.Activities.filter((a) => chapters.has(a.chapterId)).map(
          (a) => a.id,
        )
        : [],
    );
    const materials = new Set(
      target === "courses"
        ? before.Materials.filter((m) => chapters.has(m.chapterId)).map(
          (m) => m.id,
        )
        : [],
    );
    const affected = (r) =>
      target === "work"
        ? (!q.courseId || offerings.has(r.offeringId)) &&
        (!q.groupId ||
          groupStudents.has(r.studentId) ||
          enrollGroups.has(r.offeringId + ":" + r.studentId)) &&
        (!q.studentId || r.studentId === q.studentId) &&
        (!q.activityId || r.activityId === q.activityId) &&
        (!q.activityId || !r.materialId)
        : students.has(r.studentId) ||
        offerings.has(r.offeringId) ||
        activities.has(r.activityId) ||
        materials.has(r.materialId);
    const work = new Set(before.Submissions.filter(affected).map((s) => s.id));
    desired.History = before.History.filter((r) => !work.has(r.submissionId));
    ["Submissions", "Progress", "Runs", "Enrollments"].forEach((k) => {
      if (desired[k]) desired[k] = before[k].filter((r) => !affected(r));
    });
    if (target === "courses") {
      desired.Courses = before.Courses.filter((r) => !selected.has(r.id));
      desired.Offerings = before.Offerings.filter((r) => !offerings.has(r.id));
      desired.Chapters = before.Chapters.filter((r) => !chapters.has(r.id));
      ["Activities", "Materials"].forEach(
        (k) =>
          (desired[k] = before[k].filter((r) => !chapters.has(r.chapterId))),
      );
    }
    if (target === "groups")
      desired.Enrollments = desired.Enrollments.filter(
        (r) => !selected.has(r.groupId),
      );
    if (target === "students" || target === "groups") {
      ["Students", "Users", "Profiles"].forEach(
        (k) => (desired[k] = before[k].filter((r) => !students.has(r.id))),
      );
      if (target === "groups")
        desired.Groups = before.Groups.filter((r) => !selected.has(r.id));
    }
  }
  const patches = adminDiff_(
    before,
    Object.assign({ maintenance: before.maintenance }, desired),
    keys,
  );
  return { keys, before, desired, patches, labels, count: patches.length };
}
function adminManagePreview_(q) {
  teacher_(q);
  adminReady_();
  const p = adminPlan_(q);
  const details = p.keys
    .map((k) => ({
      table: k,
      current: p.before[k].length,
      remaining: p.desired[k].length,
      changed: p.patches.filter((x) => x.key === k).length,
    }))
    .filter((d) => d.changed);
  const signed = {
    target: q.target,
    mode: q.mode,
    ids: q.ids || "",
    courseId: q.courseId || "",
    groupId: q.groupId || "",
    studentId: q.studentId || "",
