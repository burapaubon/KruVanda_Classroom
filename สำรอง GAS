  adminReady_();
  const id = id_("AUD"),
    now = new Date().toISOString(),
    before = keys ? adminState_(keys) : null;
  if (q.action === "saveProfile")
    before.Users.forEach((u) => delete u.password);
  const initial = before ? JSON.stringify({ before, keys }) : "";
  let file = null;
  if (initial.length > 45000)
    file = historyFile_("LMS action " + id + ".json", initial);
  const deleted =
    ["deleteGroup", "deleteMaterial", "deleteEntity"].includes(q.action) ||
    (q.action === "bulkManage" && q.mode === "delete") ||
    (q.action === "adminManage" &&
      ["delete", "clearWork", "reset"].includes(q.mode));
  write_("AdminHistory", {
    id,
    action: q.action,
    target: q.id || q.target || q.entity || "",
    status: "pending",
    updatedAt: now,
    snapshotFileId: file ? file.getId() : "",
    snapshotJson: file ? "" : initial,
    changeCount: 0,
    message: "กำลังดำเนินการ",
    deleted,
    actor: actor.fullName || "ครู",
  });
  let result, error;
  try {
    result = fn(q);
  } catch (e) {
    error = e;
  }
  const after = keys ? adminState_(keys) : null;
  if (q.action === "saveProfile") after.Users.forEach((u) => delete u.password);
  const patches = keys ? adminDiff_(before, after, keys) : [];
  const encoded = JSON.stringify({ patches });
  try {
    if (encoded.length > 45000) {
      if (file) file.setContent(encoded);
      else
        file = historyFile_("LMS action " + id + ".json", encoded);
    }
    write_("AdminHistory", {
      id,
      status: error ? (patches.length ? "partial" : "failed") : "success",
      snapshotFileId: encoded.length > 45000 ? file.getId() : "",
      snapshotJson: encoded.length <= 45000 ? encoded : "",
      changeCount: patches.length,
      target: adminTarget_(q, patches),
      message: error ? error.message : adminDescribe_(q, patches, result),
    });
    if (file && encoded.length <= 45000) {
      try {
        file.setTrashed(true);
      } catch (_) { }
    }
  } catch (auditError) {
    const uncertain = Error(
      "ผลการดำเนินการยังยืนยันไม่ได้ กรุณาตรวจข้อมูลและประวัติก่อนทำซ้ำ",
    );
    uncertain.code = "REQUEST_UNCERTAIN";
    throw uncertain;
  }
  if (error) {
    if (patches.length) error.code = "REQUEST_UNCERTAIN";
    else if (!error.code) error.code = "ACTION_REJECTED";
    throw error;
  }
  return result;
}

