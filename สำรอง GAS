  const old = q.id ? get_("Materials", q.id) : null;

  let fileId = old ? old.fileId : "",
    mime = old ? old.mime : "",
    url = q.url ? uRL_(q.url) : old ? old.url : "";
  const title = need_(q.title, "ชื่อสื่อ", 150),
    kind = enum_(q.kind, ["knowledge", "extra"]);
  if (q.file) {
    if (old && old.fileId) throw Error("ลบสื่อเดิมก่อนอัปโหลดไฟล์ใหม่");
    mime = enum_(q.file.mime, [
      "application/pdf",
      "image/png",
      "image/jpeg",
      "image/webp",
    ]);
    if (typeof q.file.data !== "string" || q.file.data.length > 4200000)
      throw Error("ไฟล์ต้องไม่เกิน 3 MB");
    const bytes = Utilities.base64Decode(q.file.data);
    if (bytes.length > 3145728) throw Error("ไฟล์ต้องไม่เกิน 3 MB");
    const root = DriveApp.getFolderById(
      PropertiesService.getScriptProperties().getProperty("KV_DRIVE_FOLDER_ID"),
    );
    const children = root.getFoldersByName(chapter.courseId);
    const courseFolder = children.hasNext()
      ? children.next()
      : root.createFolder(chapter.courseId);
    const folders = courseFolder.getFoldersByName(chapter.id);
    const folder = folders.hasNext()
      ? folders.next()
      : courseFolder.createFolder(chapter.id);
    const file = folder.createFile(
      Utilities.newBlob(bytes, mime, need_(q.file.name, "ชื่อไฟล์", 150)),
    );
    try {
      file.setSharing(
        DriveApp.Access.ANYONE_WITH_LINK,
        DriveApp.Permission.VIEW,
      );
      fileId = file.getId();
      url = "https://drive.google.com/file/d/" + fileId + "/view";
    } catch (err) {
      file.setTrashed(true);
      throw Error(
        "แชร์สื่อไม่ได้: นโยบาย Google Workspace อาจจำกัดการแชร์ ให้ใช้ลิงก์ที่นักเรียนเปิดได้",
      );
    }
  }
  if (!url) throw Error("ใส่ลิงก์หรือเลือกไฟล์");
  try {
    return clean_(
      write_("Materials", {
        id: q.id || id_("MAT"),
        chapterId: q.chapterId,
        title,
        kind,
        url,
        fileId,
        mime,
        status: "active",
      }),
    );
  } catch (err) {
    if (q.file && fileId) DriveApp.getFileById(fileId).setTrashed(true);
    throw err;
  }
}

