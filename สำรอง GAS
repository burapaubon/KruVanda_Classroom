function questions_(questions) {
  if (!Array.isArray(questions) || !questions.length || questions.length > 100)
    throw Error("ต้องมีคำถาม 1–100 ข้อ");
  const out = questions.map((x, i) => {
    const type = enum_(x.type, ["text", "single", "boolean"]),
      points = Number(x.points);
    if (!Number.isFinite(points) || points <= 0 || points > 100)
      throw Error("คะแนนข้อ " + (i + 1) + " ต้องมากกว่า 0 และไม่เกิน 100");
    const options =
      type === "text"
        ? []
        : type === "boolean"
          ? ["ใช่", "ไม่ใช่"]
          : (x.options || []).map((o) => need_(o, "ตัวเลือก", 500));
    if (type !== "text" && (options.length < 2 || options.length > 10))
      throw Error("ตัวเลือก 2–10 ตัวเลือก");
    const correct = type === "text" ? null : Number(x.correct);
    if (
      type !== "text" &&
      (!Number.isInteger(correct) || correct < 0 || correct >= options.length)
    )
      throw Error("เลือกเฉลยให้ตรงตัวเลือก");
    return {
      id: x.id || id_("Q"),
      text: need_(x.text, "คำถาม", 2000),
      type,
      points,
      options,
      correct,
    };
  });
  if (new Set(out.map((x) => x.id)).size !== out.length)
    throw Error("รหัสคำถามซ้ำ");
  if (JSON.stringify(out).length > 45000)
    throw Error("คำถามรวมยาวเกินไป กรุณาแยกกิจกรรม");
  return out;
}

