function requestPayload_(value) {
  if (Array.isArray(value)) return value.map(requestPayload_);
  if (value && typeof value === "object")
    return Object.keys(value)
      .filter((key) => !["token", "requestId", "traceId", "attempt"].includes(key))
      .sort()
      .reduce((out, key) => {
        out[key] = requestPayload_(value[key]);
        return out;
      }, {});
  return value;
}

function mutationSync_(q, teacherMutation) {
  if (!teacherMutation) return null;
  const tablesByAction = {
    saveGroup: ["Groups"],
    saveStudent: ["Students"],
    importStudents: ["Students"],
    replaceRoster: ["Students"],
    studentsBatch: ["Students"],
    promote: ["Students"],
    saveCourse: ["Courses"],
    ensureOffering: ["Offerings"],
    saveOffering: ["Offerings"],
    enroll: ["Enrollments"],
    removeRoom: ["Enrollments"],
    deleteGroup: ["Groups", "Students", "Enrollments"],
    saveChapter: [],
    saveMaterial: [],
    deleteMaterial: [],
    saveActivity: [],
    grade: [],
    returnWork: [],
    resetPassword: [],
    setMaintenance: [],
    backup: [],
    saveProfile: [],
    changePassword: [],
    adminPurge: [],
  };
  let keys = tablesByAction[q.action];
  if (q.action === "setStatus")
    keys = [
      "Groups",
      "Students",
      "Courses",
      "Offerings",
      "Enrollments",
    ].includes(q.entity)
      ? [q.entity]
      : [];
  if (q.action === "deleteEntity")
    keys =
      q.kind === "course"
        ? ["Courses", "Offerings", "Enrollments"]
        : q.kind === "student"
          ? ["Students", "Enrollments"]
          : null;
  if (q.action === "adminManage" && ["sessions", "work"].includes(q.target))
    keys = [];
  if (!keys) return null;
  const tables = {};
  keys.forEach((key) => (tables[key] = rows_(key).map(clean_)));
  return { tables, maintenance: maintenance_() };
}

function apiCall(json) {
  let lock = null,
    requestId = "",
    requestHash = "",
    executed = false,
    mutation = false,
    teacherMutation = false;
  let diagnosticAction = "ไม่ระบุ", diagnosticTrace = Utilities.getUuid(), diagnosticStage = "ตรวจคำขอ";
  const startedAt = Date.now();
  try {
    MEM = {};
    BOOK = null;
    const q = typeof json === "string" ? JSON.parse(json) : json;
    if (!q || typeof q !== "object" || Array.isArray(q))
      throw Error("คำขอไม่ถูกต้อง");
    q.action = q.action || "login";
    diagnosticAction = String(q.action).slice(0, 80);
    if (typeof q.traceId === "string" && /^[a-zA-Z0-9-]{1,80}$/.test(q.traceId)) diagnosticTrace = q.traceId;
    if (
      !ACTIONS[q.action] &&
      !["sessionCheck", "sessionTouch", "logout", "profile"].includes(q.action)
    )
      throw Error("คำสั่งนี้ไม่รองรับ กรุณาตรวจเวอร์ชันของเว็บและ GAS");
    mutation =
      !READS.includes(q.action) &&
      !["login", "logout", "sessionTouch", "presenceHeartbeat"].includes(
        q.action,
      );
    if (!READS.includes(q.action) && q.action !== "login") {
      diagnosticStage = "รอสิทธิ์บันทึกข้อมูล";
      lock = LockService.getScriptLock();
      if (!lock.tryLock(5000)) {
        const e = Error("ระบบกำลังบันทึกข้อมูล กรุณาลองใหม่ในอีกสักครู่");
        e.code = "SYSTEM_BUSY";
        throw e;
      }
    }
    if (q.requestId && mutation) {
      const user = auth_(q);
      teacherMutation = user.role === "teacher";
      requestId = digest_(user.id + ":" + need_(q.requestId, "รหัสคำขอ", 150));
      requestHash = digest_(JSON.stringify(requestPayload_(q)));
      const previous = findRow_("Requests", requestId);
      if (previous) {
        if (
          previous.action !== q.action ||
          previous.payloadHash !== requestHash
        )
          throw Error("รหัสคำขอซ้ำกับข้อมูลอื่น กรุณาโหลดข้อมูลล่าสุด");
        const replayed = JSON.parse(previous.result);
        delete replayed.sync;
        return JSON.stringify(replayed);
      }
      writeOne_("Requests", {
        id: requestId,
        action: q.action,
        payloadHash: requestHash,
        updatedAt: new Date().toISOString(),
        result: JSON.stringify({
          status: "error",
          code: "REQUEST_UNCERTAIN",
          message:
            "คำขอนี้เริ่มทำงานแล้วแต่ยังไม่มีผลยืนยัน กรุณาตรวจข้อมูลและประวัติก่อนส่งคำสั่งใหม่",
        }),
      });
      SpreadsheetApp.flush();
    }
    diagnosticStage = "ประมวลผลคำสั่ง " + diagnosticAction;
    executed = true;
    let data;
    if (["sessionCheck", "sessionTouch"].includes(q.action))
      data = sessionInfo_(q, q.action === "sessionTouch");
    else if (q.action === "logout") {
      auth_(q);
      const id = digest_(q.token);
      writeOne_("Sessions", { id, expiresAt: 0 });
      CacheService.getScriptCache().remove("kv_s_" + id);
      data = { loggedOut: true };
    } else if (q.action === "profile") data = profile_(q);
    else data = adminAudited_(q, ACTIONS[q.action]);
    const response = { status: "success", action: q.action, data, traceId: diagnosticTrace };
    if (mutation && q.requestId) {
      try {
        const sync = mutationSync_(q, teacherMutation);
        if (sync && JSON.stringify({ ...response, sync }).length < 40000)
          response.sync = sync;
      } catch (_) { }
    }
    response.serverMs = Date.now() - startedAt;
    const result = JSON.stringify(response);
    if (requestId) {
      const storedResponse = { ...response };
      delete storedResponse.sync;
      const persistedResult = JSON.stringify(storedResponse);
      if (persistedResult.length > 45000)
        throw Error("ผลคำขอใหญ่เกินกำหนด กรุณาตรวจรายการล่าสุด");
      writeOne_("Requests", { id: requestId, result: persistedResult });
    }
    console.info(JSON.stringify({ traceId: diagnosticTrace, action: diagnosticAction, status: "success", serverMs: Date.now() - startedAt }));
    return result;
  } catch (err) {
    const diagnostics = {
      stage: err.diagnosticStage || diagnosticStage,
      resource: err.diagnosticResource || "",
      outcome: mutation && executed ? "unknown" : "failed",
      advice: err.code === "AUTH_EXPIRED" ? "กรุณาเข้าสู่ระบบใหม่"
        : err.code === "SYSTEM_BUSY" ? "มีคำสั่งอื่นกำลังทำงาน กรุณาลองอีกครั้ง"
          : err.diagnosticResource === "Google Sheets" ? "ตรวจการตั้งค่าชีตและสิทธิ์ของบัญชีที่ใช้รัน GAS"
            : err.diagnosticResource === "Sessions / Users" ? "ตรวจข้อมูลเซสชันและสถานะบัญชีใน GAS"
              : err.diagnosticResource ? "ตรวจชื่อชีตและสิทธิ์เข้าถึง หากขาดชีตให้รัน updatesheet แล้วลองใหม่"
                : "ตรวจบันทึกการทำงาน GAS ด้วยรหัสติดตามนี้",
    };
    console.error(JSON.stringify({
      traceId: diagnosticTrace, action: diagnosticAction,
      code: err.code || "API_ERROR", stage: diagnostics.stage, resource: diagnostics.resource,
      outcome: diagnostics.outcome, serverMs: Date.now() - startedAt
    }));
    const result = JSON.stringify({
      status: "error",
      message: err.message || String(err),
      code: err.code || "API_ERROR",
      authReason: err.authReason || "",
      action: diagnosticAction, traceId: diagnosticTrace, diagnostics,
      serverMs: Date.now() - startedAt,
    });
    if (requestId && executed) {
      try {
        writeOne_("Requests", { id: requestId, result });
      } catch (_) { }
    }
    return result;
  } finally {
    if (mutation && executed) {
      try {
        PropertiesService.getScriptProperties().setProperty(
          "KV_DATA_REVISION",
          Utilities.getUuid(),
        );
      } catch (_) { }
    }
    if (lock && lock.hasLock()) {
      try {
        SpreadsheetApp.flush();
      } finally {
        lock.releaseLock();
      }
    }
  }
}

