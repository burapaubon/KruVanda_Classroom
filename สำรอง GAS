function adminDependencyConflicts_(patches) {
  const current = adminState_(ADMIN_TABLES),
    desired = {};
  ADMIN_TABLES.forEach(
    (k) => (desired[k] = new Map(current[k].map((r) => [r.id, r]))),
  );
  patches
    .filter((p) => p.key !== "$maintenance")
    .forEach((p) => {
      if (p.before) desired[p.key].set(p.id, p.before);
      else desired[p.key].delete(p.id);
    });
  const links = {
    Students: { groupId: "Groups" },
    Offerings: { courseId: "Courses" },
    Enrollments: {
      studentId: "Students",
      offeringId: "Offerings",
      groupId: "Groups",
    },
    Chapters: { courseId: "Courses" },
    Materials: { chapterId: "Chapters" },
    Activities: { chapterId: "Chapters" },
    Submissions: {
      studentId: "Students",
      activityId: "Activities",
      offeringId: "Offerings",
    },
    Progress: {
      studentId: "Students",
      materialId: "Materials",
      offeringId: "Offerings",
    },
    Runs: {
      studentId: "Students",
      activityId: "Activities",
      offeringId: "Offerings",
    },
    History: { submissionId: "Submissions" },
  };
  const touched = new Set(patches.map((p) => p.key + ":" + p.id)),
    conflicts = [];
  Object.keys(links).forEach((key) =>
    desired[key].forEach((row) => {
      Object.keys(links[key]).forEach((field) => {
        const parent = links[key][field],
          id = row[field];
        if (!id || desired[parent].has(id)) return;
        if (
          touched.has(key + ":" + row.id) ||
          current[parent].some((r) => r.id === id)
        )
          conflicts.push({
            table: key,
            name: row.fullName || row.name || row.title || row.id,
            operation:
              "มีข้อมูลอ้างอิง " + parent + " ที่จะหายไปหรือยังไม่ถูกกู้",
            conflict: true,
          });
      });
    }),
  );
  return conflicts;
}

