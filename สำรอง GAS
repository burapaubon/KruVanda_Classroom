function adminHistoryIndex_() {
  const columns = SCHEMA.AdminHistory.filter((name) => name !== "snapshotJson");
  if (MEM.AdminHistory)
    return MEM.AdminHistory.map((row) => {
      const item = { _row: row._row, hasInlineSnapshot: !!row.snapshotJson };
      columns.forEach((name) => (item[name] = row[name]));
      return item;
    });
  const sheet = book_().getSheetByName("AdminHistory"),
    count = sheet.getLastRow() - 1;
  if (count < 1) return [];
  return sheet
    .getRange(2, 1, count, columns.length)
    .getValues()
    .map((line, index) => {
      const item = { _row: index + 2 };
      columns.forEach((name, col) => (item[name] = line[col]));
      return item;
    })
    .filter((row) => row.id);
}

function adminHistorySnapshotFlags_(page) {
  const candidates = page
    .filter(
      (row) =>
        row.hasInlineSnapshot === undefined &&
        !row.snapshotFileId &&
        Number(row.changeCount) > 0 &&
        ["success", "partial"].includes(row.status) &&
        Date.now() - new Date(row.updatedAt).getTime() <= 90 * 86400000 &&
        ![
          "adminUndo",
          "adminRestore",
          "saveProfile",
          "changePassword",
        ].includes(row.action),
    )
    .sort((a, b) => a._row - b._row);
  if (!candidates.length) return;
  const sheet = book_().getSheetByName("AdminHistory"),
    column = SCHEMA.AdminHistory.indexOf("snapshotJson") + 1;
  const spans = [];
  candidates.forEach((row) => {
    const span = spans[spans.length - 1];
    if (span && row._row === span[span.length - 1]._row + 1) span.push(row);
    else spans.push([row]);
  });
  spans.forEach((span) => {
    const values = sheet
      .getRange(span[0]._row, column, span.length, 1)
      .getValues();
    span.forEach((row, index) => (row.hasInlineSnapshot = !!values[index][0]));
  });
}

