    sessionIds: p.sessionIds || [],
  };
  return {
    total: p.count,
    names: p.labels.slice(0, 200),
    details,
    fingerprint: digest_(JSON.stringify(signed)),
    confirmText:
      q.mode === "reset"
        ? "เริ่มระบบใหม่"
        : ["delete", "clearWork"].includes(q.mode)
          ? "ลบข้อมูล"
          : "ยืนยัน",
