function diagnosticOperation_(stage, resource, operation) {
  try { return operation(); }
  catch (error) {
    if (!error.diagnosticStage) {
      error.diagnosticStage = stage;
      error.diagnosticResource = resource;
      if (!error.code) error.code = {
        "เปิดฐานข้อมูล": "SPREADSHEET_ACCESS_FAILED",
        "อ่านชีต": "SHEET_READ_FAILED",
        "ค้นหารายการในชีต": "SHEET_LOOKUP_FAILED",
        "บันทึกรายการในชีต": "SHEET_WRITE_FAILED",
        "บันทึกข้อมูลในชีต": "SHEET_WRITE_FAILED",
        "เขียนข้อมูลชีตใหม่": "SHEET_REWRITE_FAILED",
        "ตรวจเซสชันและสิทธิ์": "AUTH_CHECK_FAILED",
      }[stage] || "API_ERROR";
    }
    throw error;
  }
}

