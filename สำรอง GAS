function submitActivity_(q) {
  const u = auth_(q, "student"),
    a = activityAccess_(u.id, q),
    id = digest_(u.id + ":" + q.offeringId + ":" + a.id);
  const run = get_("Runs", id);
  if (Number(run.expiresAt) && Date.now() > Number(run.expiresAt) + 5000)
    throw Error("หมดเวลาทำกิจกรรมแล้ว");
  const old = rows_("Submissions").find((s) => s.id === id);
  if (old && old.status !== "returned" && (!a.allowEdit || a.kind === "quiz"))
    throw Error("ส่งกิจกรรมนี้แล้ว");
  const questions = json_(run.questionSnapshot || a.questions, []);
  if (!Array.isArray(q.answers) || q.answers.length !== questions.length)
    throw Error("ตอบคำถามให้ครบ");
  const answers = q.answers.map((v, i) => {
    if (questions[i].type === "text")
      return need_(v, "คำตอบข้อ " + (i + 1), 5000);
    const n = Number(v);
    if (
      v === "" ||
      v == null ||
      !Number.isInteger(n) ||
      n < 0 ||
      n >= questions[i].options.length
    )
      throw Error("คำตอบตัวเลือกไม่ถูกต้อง");
    return n;
  });
  if (JSON.stringify(answers).length > 45000)
    throw Error("คำตอบรวมยาวเกิน 45,000 ตัวอักษร");
  const scores = questions.map((x, i) =>
    x.type === "text" ? null : answers[i] === x.correct ? x.points : 0,
  );
  const status = scores.some((x) => x === null) ? "pending" : "graded";
  if (old) saveHistory_(old);
  write_("Submissions", {
    id,
    activityId: a.id,
    offeringId: q.offeringId,
    studentId: u.id,
    answers: JSON.stringify(answers),
    scores: JSON.stringify(scores),
    feedback: "",
    status,
    revision: old ? Number(old.revision) + 1 : 1,
    updatedAt: new Date().toISOString(),
    questionSnapshot: JSON.stringify(questions),
    submittedAt: new Date().toISOString(),
  });
  write_("Runs", { id, status: "submitted" });
  return {
    id,
    status,
    score: scores.reduce((n, s) => n + (s || 0), 0),
    maxScore: questions.reduce((n, x) => n + x.points, 0),
    correctAnswers: a.showAnswers ? questions.map((x) => x.correct) : undefined,
  };
}

