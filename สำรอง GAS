function submissionsData_(q) {
  const activeCourses = new Set(
    rows_("Courses")
      .filter(
        (c) => c.status === "active" && (!q.courseId || c.id === q.courseId),
      )
      .map((c) => c.id),
  );
  const offeringIds = q.offeringId
    ? new Set([get_("Offerings", q.offeringId).id])
    : new Set(
      rows_("Offerings")
        .filter((o) => o.status === "active" && activeCourses.has(o.courseId))
        .map((o) => o.id),
    );
  const students = new Map(rows_("Students").map((s) => [s.id, s]));
  const activityNames = new Map();
  const dueDates = new Map();
  rows_("Activities").forEach((a) => {
    activityNames.set(a.id, a.title);
    if (a.dueAt) {
      if (!dueDates.has(a.id)) dueDates.set(a.id, []);
      dueDates.get(a.id).push(new Date(a.dueAt).getTime());
    }
  });
  const groups = new Map(
    rows_("Enrollments")
      .filter((e) => offeringIds.has(e.offeringId))
      .map((e) => [e.offeringId + ":" + e.studentId, e.groupId]),
  );
  const scoped = rows_("Submissions").filter(
    (s) =>
      offeringIds.has(s.offeringId) &&
      (!q.groupId ||
        ((students.get(s.studentId) || {}).groupId ||
          groups.get(s.offeringId + ":" + s.studentId)) === q.groupId) &&
      (!q.studentId || s.studentId === q.studentId),
  );
  const counts = {
    total: scoped.length,
    pending: scoped.filter((s) => s.status === "pending").length,
    graded: scoped.filter((s) => s.status === "graded").length,
    returned: scoped.filter((s) => s.status === "returned").length,
  };
  const filtered = scoped.filter(
    (s) =>
      (!q.status || s.status === q.status) &&
      (!q.pendingOnly || s.status === "pending") &&
      (!q.search ||
        String((students.get(s.studentId) || {}).fullName || "")
          .toLocaleLowerCase("th")
          .includes(text_(q.search).toLocaleLowerCase("th"))) &&
      (!q.activityId || s.activityId === q.activityId),
  );
  filtered.sort((a, b) =>
    String(a.updatedAt).localeCompare(String(b.updatedAt)),
  );
  const offset = Math.max(0, Number(q.offset) || 0),
    limit = 50;
  return {
    total: filtered.length,
    counts,
    activities: [...new Set(scoped.map((s) => s.activityId))].map((id) => ({
      id,
      title: activityNames.get(id) || "กิจกรรม",
    })),
    items: filtered.slice(offset, offset + limit).map((s) => ({
      id: s.id,
      offeringId: s.offeringId,
      activityId: s.activityId,
      activityTitle: activityNames.get(s.activityId) || "กิจกรรม",
      late:
        !!s.submittedAt &&
        (dueDates.get(s.activityId) || []).some(
          (due) => new Date(s.submittedAt).getTime() > due,
        ),
      studentId: s.studentId,
      studentName: (students.get(s.studentId) || {}).fullName || s.studentId,
      status: s.status,
      revision: s.revision,
      updatedAt: s.updatedAt,
      scores: json_(s.scores, []),
      maxScore: json_(s.questionSnapshot, []).reduce((n, x) => n + x.points, 0),
    })),
  };
}

