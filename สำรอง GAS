function summaryCache_(action, q, compute) {
  const properties = PropertiesService.getScriptProperties();
  const revision = properties.getProperty("KV_DATA_REVISION") || "0";
  const key =
    "kv_summary_" +
    action +
    "_" +
    digest_(
      JSON.stringify([
        revision,
        q.courseId || "",
        q.offeringId || "",
        q.groupId || "",
        q.kind || "",
        Number(q.offset) || 0,
        q.studentId || "",
        q.status || "",
        q.search || "",
        q.activityId || "",
        !!q.pendingOnly,
      ]),
    );
  const cache = CacheService.getScriptCache();
  if (!q.forceRefresh) {
    const saved = cache.get(key);
    if (saved) {
      try {
        return JSON.parse(saved);
      } catch (_) { }
    }
  }
  const data = compute();
  const encoded = JSON.stringify(data);
  if (Utilities.newBlob(encoded).getBytes().length < 95000)
    cache.put(key, encoded, action === "base" ? 300 : 180);
  return data;
}
function presenceHeartbeat_(q) {
  const user = auth_(q, "student"),
    now = Date.now(),
    id = digest_(q.token),
    session = get_("Sessions", id);
  if (now - Number(session.lastSeenAt || 0) >= 45000) {
    const updated = writeOne_("Sessions", { id, lastSeenAt: now });
    CacheService.getScriptCache().put(
      "kv_s_" + id,
      JSON.stringify(updated),
      120,
    );
    if (now - Number(user.lastSeenAt || 0) >= 300000)
      writeOne_("Users", { id: user.id, lastSeenAt: now });
  }
  return { serverNow: now, expiresAt: Number(session.expiresAt) };
}
function studentPresence_(q) {
  teacher_(q);
  const now = Date.now(),
    users = new Map(rows_("Users").map((u) => [u.id, u]));
  const sessions = new Map(),
    groups = new Map(rows_("Groups").map((g) => [g.id, g]));
  rows_("Sessions").forEach((s) => {
    if (!sessions.has(s.userId)) sessions.set(s.userId, []);
    sessions.get(s.userId).push(s);
  });
  const closed = maintenance_();
  return {
    serverNow: now,
    items: rows_("Students").map((student) => {
      const user = users.get(student.id) || {},
        history = sessions.get(student.id) || [];
      const lastLoginAt = Number(user.lastLoginAt) || 0;
      const lastSeenAt = Math.max(
        Number(user.lastSeenAt) || 0,
        ...history.map((s) => Number(s.lastSeenAt) || 0),
      );
      const online =
        !closed &&
        student.status === "active" &&
        user.status === "active" &&
        groups.get(student.groupId)?.status === "active" &&
        history.some(
          (s) =>
            Number(s.version) === Number(user.version) &&
            Number(s.expiresAt) > now &&
            Number(s.lastSeenAt) > 0 &&
            now - Number(s.lastSeenAt) < 120000,
        );
      const used =
        user.hasLoggedIn === true ||
        String(user.hasLoggedIn).toLowerCase() === "true" ||
        lastLoginAt > 0 ||
        lastSeenAt > 0 ||
        history.length > 0;
      const known =
        user.loginHistoryKnown === true ||
        String(user.loginHistoryKnown).toLowerCase() === "true";
      return {
        studentId: student.id,
        status: online
          ? "online"
          : used
            ? "offline"
            : known
              ? "never"
              : "unknown",
        lastLoginAt,
        lastSeenAt,
      };
    }),
  };
}

function bootstrap_(q) {
  teacher_(q);
  const compute = () => {
    const out = {};
    ["Groups", "Students", "Courses", "Offerings", "Enrollments"].forEach(
      (k) => (out[k] = rows_(k).map(clean_)),
    );
    out.Settings = { maintenance: maintenance_() };
    return out;
  };
  let base = summaryCache_("base", q, compute);
  const required = ["Groups", "Students", "Courses", "Offerings", "Enrollments"];
  if (!base || !required.every((key) => Array.isArray(base[key])))
    base = summaryCache_("base", Object.assign({}, q, { forceRefresh: true }), compute);
  return q.includePresence === false
    ? base
    : Object.assign({}, base, { Presence: studentPresence_(q) });
}

function dashboardRows_(key, columns) {
  if (MEM[key]) return MEM[key];
  const sheet = book_().getSheetByName(key);
  if (!sheet) throw Error("เรียก updatesheet ก่อน: " + key);
  const count = sheet.getLastRow() - 1;
  if (count < 1) return [];
  const rows = Array.from({ length: count }, () => ({}));
  const positions = columns
    .map((name) => ({ name, index: SCHEMA[key].indexOf(name) }))
    .sort((a, b) => a.index - b.index);
  const spans = [];
  positions.forEach((field) => {
    const last = spans[spans.length - 1];
    if (last && field.index === last[last.length - 1].index + 1)
      last.push(field);
    else spans.push([field]);
  });
  spans.forEach((span) => {
    const values = sheet
      .getRange(2, span[0].index + 1, count, span.length)
      .getValues();
    values.forEach((line, i) =>
      span.forEach((field, j) => (rows[i][field.name] = line[j])),
    );
  });
  return rows.filter((row) => row.id);
}

