function diagnosticOriginal_book_() {
  if (!BOOK) {
    const id =
      PropertiesService.getScriptProperties().getProperty("KV_SPREADSHEET_ID");
    BOOK = id
      ? SpreadsheetApp.openById(id)
      : SpreadsheetApp.getActiveSpreadsheet();
  }
  if (!BOOK) throw Error("เปิด Apps Script จากชีทและเรียก updatesheet ก่อน");
  return BOOK;
}

function updatesheet() {
  const lock = LockService.getScriptLock();
  lock.waitLock(15000);
  try {
    MEM = {};
    BOOK = null;
    const props = PropertiesService.getScriptProperties();
    const savedId = props.getProperty("KV_SPREADSHEET_ID");
    const ss =
      SpreadsheetApp.getActiveSpreadsheet() ||
      (savedId
        ? SpreadsheetApp.openById(savedId)
        : SpreadsheetApp.create("KruVanda LMS"));
    BOOK = ss;
    props.setProperty("KV_SPREADSHEET_ID", ss.getId());
    Object.keys(SCHEMA).forEach((key) => {
      const headers = SCHEMA[key];
      let sheet = ss.getSheetByName(key);
      const legacy = ss.getSheetByName("KV_" + key);
      if (sheet && legacy)
        throw Error(
          "พบชีทซ้ำ " + key + " และ KV_" + key + " กรุณาตรวจข้อมูลก่อน",
        );
      if (!sheet && legacy) sheet = legacy.setName(key);
      if (!sheet) sheet = ss.insertSheet(key);
      if (sheet.getLastRow() === 0)
        sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
      else {
        const actual = sheet
          .getRange(1, 1, 1, Math.max(sheet.getLastColumn(), headers.length))
          .getValues()[0];
        const populated = actual.filter((v) => v !== "");
        if (
          populated.length > headers.length ||
          populated.some((v, i) => v !== headers[i])
        )
          throw Error("หัวตาราง " + key + " ไม่ตรง กรุณาตรวจข้อมูลก่อน");
        if (populated.length < headers.length)
          sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
      }
      sheet.setFrozenRows(1);
      sheet
        .getRange(1, 1, 1, headers.length)
        .setFontWeight("bold")
        .setBackground("#ffe8bd");
    });
    const previouslyLoggedIn = new Set(
      rows_("Sessions").map((session) => session.userId),
    );
    rows_("Users")
      .filter(
        (user) => user.role === "student" && previouslyLoggedIn.has(user.id),
      )
      .forEach((user) =>
        writeOne_("Users", {
          id: user.id,
          hasLoggedIn: true,
          loginHistoryKnown: true,
        }),
      );
    if (!props.getProperty("KV_DRIVE_FOLDER_ID")) {
      props.setProperty(
        "KV_DRIVE_FOLDER_ID",
        DriveApp.createFolder("KruVanda LMS — สื่อบทเรียน").getId(),
      );
    }
    if (!rows_("Users").some((u) => u.role === "teacher")) {
      const username = "teacher",
        password = "12345678";
      write_("Users", {
        id: "TEACHER",
        username: name_(username),
        password: hash_(password),
        role: "teacher",
        status: "active",
        fullName: "ครูแวนด้า",
        version: 1,
      });
    }
    installLmsCleanup();
    rows_("Courses")
      .filter((c) => c.status === "hidden")
      .forEach((c) => write_("Courses", { id: c.id, status: "closed" }));
    const profileSheet = ss.getSheetByName("Profiles"),
      phoneColumn = SCHEMA.Profiles.indexOf("phone") + 1;
    if (profileSheet.getLastRow() > 1) {
      const phoneRange = profileSheet.getRange(
        2,
        phoneColumn,
        profileSheet.getLastRow() - 1,
        1,
      );
      const phones = phoneRange.getValues().map((r) => [phoneText_(r[0])]);
      phoneRange.setNumberFormat("@").setValues(phones);
      delete MEM.Profiles;
    }
    profileSheet
      .getRange(2, phoneColumn, Math.max(1, profileSheet.getMaxRows() - 1), 1)
      .setNumberFormat("@");
    SpreadsheetApp.flush();
    const result =
      "พร้อมใช้งาน " + Object.keys(SCHEMA).length + " ชีท: " + ss.getUrl();
    console.log(result);
    return result;
  } finally {
    lock.releaseLock();
  }
}

function diagnosticOriginal_rows_(key) {
  if (MEM[key]) return MEM[key];
  const s = book_().getSheetByName(key);
  if (!s) throw Error("เรียก updatesheet ก่อน: " + key);
  const h = SCHEMA[key],
    n = s.getLastRow();
  MEM[key] =
    n < 2
      ? []
      : s
        .getRange(2, 1, n - 1, h.length)
        .getValues()
        .map((r, i) => {
          const o = { _row: i + 2 };
          h.forEach((k, j) => (o[k] = r[j]));
          return o;
        })
        .filter((o) => o.id);
  return MEM[key];
}

function cell_(v) {
  if (v == null) return "";

  return typeof v === "string" && /^[=+@-]/.test(v) ? "'" + v : v;
}

function diagnosticOriginal_write_(key, obj) {
  const list = rows_(key),
    old = list.find((r) => String(r.id) === String(obj.id));
  const value = Object.assign({}, old || {}, obj);
  if (key === "Profiles") value.phone = phoneText_(value.phone);
  const sheet = book_().getSheetByName(key),
    row = old ? old._row : sheet.getLastRow() + 1;
  ensureRows_(sheet, row);
  if (key === "Profiles")
    sheet
      .getRange(row, SCHEMA.Profiles.indexOf("phone") + 1)
      .setNumberFormat("@");
  sheet
    .getRange(row, 1, 1, SCHEMA[key].length)
    .setValues([SCHEMA[key].map((k) => cell_(value[k]))]);
  value._row = row;
  if (key === "Users") delete MEM.$auth;
  if (old) list[list.indexOf(old)] = value;
  else list.push(value);
  return value;
}

function batch_(key, objects) {
  if (!objects.length) return;
  const sheet = book_().getSheetByName(key),
    start = sheet.getLastRow() + 1;
  ensureRows_(sheet, start + objects.length - 1);
  sheet
    .getRange(start, 1, objects.length, SCHEMA[key].length)
    .setValues(objects.map((o) => SCHEMA[key].map((k) => cell_(o[k]))));
  if (MEM[key])
    objects.forEach((o, i) =>
      MEM[key].push(Object.assign({}, o, { _row: start + i })),
    );
}

function diagnosticOriginal_findRow_(key, id) {
  if (MEM[key])
    return MEM[key].find((r) => String(r.id) === String(id)) || null;
  const sheet = book_().getSheetByName(key);
  if (!sheet) throw Error("เรียก updatesheet ก่อน: " + key);
  const count = sheet.getLastRow() - 1;
  if (count <= 0) return null;
  const match = sheet
    .getRange(2, 1, count, 1)
    .createTextFinder(String(id))
    .matchEntireCell(true)
    .matchCase(true)
    .useRegularExpression(false)
    .findNext();
  if (!match) return null;
  const rowNumber = match.getRow();
  const values = sheet
    .getRange(rowNumber, 1, 1, SCHEMA[key].length)
    .getValues()[0];
  const row = { _row: rowNumber };
  SCHEMA[key].forEach((name, index) => {
    row[name] = values[index];
  });
  return row;
}

function diagnosticOriginal_writeOne_(key, obj) {
  if (MEM[key]) return write_(key, obj);
  const old = findRow_(key, obj.id),
    value = Object.assign({}, old || {}, obj);
  const sheet = book_().getSheetByName(key),
    row = old ? old._row : sheet.getLastRow() + 1;
  ensureRows_(sheet, row);
  if (key === "Profiles") {
    value.phone = phoneText_(value.phone);
    sheet
      .getRange(row, SCHEMA.Profiles.indexOf("phone") + 1)
      .setNumberFormat("@");
  }
  sheet
    .getRange(row, 1, 1, SCHEMA[key].length)
    .setValues([SCHEMA[key].map((k) => cell_(value[k]))]);
  value._row = row;
  if (key === "Users") delete MEM.$auth;
  return value;
}

function get_(key, id) {
  const row = findRow_(key, id);
  if (!row) throw Error("ไม่พบข้อมูล " + key);
  return row;
}

function id_(prefix) {
  return prefix + "_" + Utilities.getUuid().replace(/-/g, "");
}
function text_(v) {
  return String(v == null ? "" : v).trim();
}
function name_(v) {
  return text_(v).normalize("NFC").replace(/\s+/g, " ").toLowerCase();
}
function need_(v, label, max) {
  const s = text_(v);
  if (!s || s.length > max)
    throw Error(label + " ต้องมี 1–" + max + " ตัวอักษร");
  return s;
}
function enum_(v, list) {
  if (!list.includes(v)) throw Error("ค่าที่เลือกไม่ถูกต้อง");
  return v;
}
function json_(v, fallback) {
  try {
    return JSON.parse(v);
  } catch (e) {
    return fallback;
  }
}
function clean_(o) {
  const r = Object.assign({}, o);
  delete r._row;
  delete r.password;
  return r;
}
function digest_(s) {
  return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, s)
    .map((b) => ("0" + ((b + 256) % 256).toString(16)).slice(-2))
    .join("");
}
function hash_(password) {
  const salt = Utilities.getUuid();
  return "sha256$" + salt + "$" + digest_(salt + ":" + password);
}
function password_(hash, password) {
  const p = String(hash).split("$");
  return p.length === 3 && digest_(p[1] + ":" + password) === p[2];
}

function resetTeacherLogin() {
  const lock = LockService.getScriptLock();
  lock.waitLock(15000);
  try {
    MEM = {};
    BOOK = null;
    const users = rows_("Users");
    const teacher = users.find((u) => u.role === "teacher");
    if (!teacher) throw Error("เรียก updatesheet ก่อน");
    if (
      users.some((u) => u.id !== teacher.id && u.username === name_("teacher"))
    ) {
      throw Error("ชื่อผู้ใช้ teacher ถูกใช้โดยบัญชีอื่น");
    }
    write_("Users", {
      id: teacher.id,
      username: name_("KruVanda"),
      password: hash_("11223344"),
      status: "active",
      version: Number(teacher.version || 0) + 1,
    });
    SpreadsheetApp.flush();
    console.log("รีเซ็ตบัญชีครูสำเร็จ");
  } finally {
    lock.releaseLock();
  }
}

function studentRoomAccess_(studentId) {
  const student = get_("Students", studentId);
  if (student.status !== "active") throw Error("บัญชีนี้ปิดใช้งาน");
  const group = rows_("Groups").find((g) => g.id === student.groupId);
  if (!group || group.status !== "active")
    throw Error("ห้องเรียนนี้ยังไม่เปิดใช้งาน กรุณาติดต่อครู");
}

function groupImpact_(q) {
  teacher_(q);
  const group = clean_(get_("Groups", q.id));
  const students = rows_("Students").filter((s) => s.groupId === q.id);
  const ids = new Set(students.map((s) => s.id));
  const submissions = rows_("Submissions").filter((s) => ids.has(s.studentId));
  const data = {
    group,
    students: students.map(clean_),
    submissions: submissions.map(clean_),
    enrollments: rows_("Enrollments")
      .filter((e) => e.groupId === q.id || ids.has(e.studentId))
      .map(clean_),
  };
  return {
    group,
    students: students.length,
    submissions: submissions.length,
    fingerprint: digest_(JSON.stringify(data)),
  };
}

function deleteGroup_(q) {
  teacher_(q);
  enum_(q.mode, ["room", "room-students"]);
  if (q.confirmText !== "ยืนยัน") throw Error("พิมพ์ ยืนยัน ก่อนลบถาวร");
  const impact = groupImpact_(q);
  if (impact.fingerprint !== q.fingerprint)
    throw Error("ข้อมูลเปลี่ยนแล้ว กรุณาเปิดหน้าสรุปก่อนลบอีกครั้ง");
  const ids = new Set(
    rows_("Students")
      .filter((s) => s.groupId === q.id)
      .map((s) => s.id),
  );
  const backup = backup_(q);
  if (q.mode === "room-students") {
    const submissionIds = new Set(
      rows_("Submissions")
        .filter((s) => ids.has(s.studentId))
        .map((s) => s.id),
    );
    rewriteRows_(
      "History",
      rows_("History").filter((r) => !submissionIds.has(r.submissionId)),
    );
    ["Submissions", "Progress", "Runs", "Enrollments"].forEach((key) =>
      rewriteRows_(
        key,
        rows_(key).filter((r) => !ids.has(r.studentId)),
      ),
    );
    rows_("Sessions")
      .filter((s) => ids.has(s.userId))
      .forEach((s) => CacheService.getScriptCache().remove("kv_s_" + s.id));
    rewriteRows_(
      "Sessions",
      rows_("Sessions").filter((s) => !ids.has(s.userId)),
    );
    rewriteRows_(
      "Profiles",
      rows_("Profiles").filter((r) => !ids.has(r.id)),
    );
    rewriteRows_(
      "Users",
      rows_("Users").filter((r) => !ids.has(r.id)),
    );
    rewriteRows_(
      "Students",
      rows_("Students").filter((r) => !ids.has(r.id)),
    );
  } else {
    rewriteRows_(
      "Students",
      rows_("Students").map((r) =>
        r.groupId === q.id ? Object.assign({}, r, { groupId: "" }) : r,
      ),
    );
  }
  rewriteRows_(
    "Enrollments",
    rows_("Enrollments").map((r) =>
      r.groupId === q.id ? Object.assign({}, r, { groupId: "" }) : r,
    ),
  );
  rewriteRows_(
    "Groups",
    rows_("Groups").filter((r) => r.id !== q.id),
  );
  return { deleted: true, backupUrl: backup.url };
}

function login_(q) {
  const username = name_(need_(q.username, "ชื่อผู้ใช้", 100));
  const user = rows_("Users").find((u) => name_(u.username) === username);
  if (!user)
    throw Error("ไม่พบชื่อผู้ใช้นี้ในชีท Users ของระบบที่เว็บกำลังเชื่อมต่อ");
  if (user.status !== "active") throw Error("บัญชีนี้ยังไม่เปิดใช้งาน");
  if (!password_(user.password, String(q.password || ""))) {
    throw Error("รหัสผ่านไม่ตรงกับบัญชีนี้ หากเป็นครูให้รัน resetTeacherLogin");
  }
  if (user.role !== "teacher") studentRoomAccess_(user.id);
  if (user.role !== "teacher" && maintenance_())
    throw Error("ระบบปิดให้นักเรียนเข้าใช้งานชั่วคราว");
  const token = Utilities.getUuid() + Utilities.getUuid();

  const expiresAt = Date.now() + sessionIdleMs_(user.role);
  const sessionLock = LockService.getScriptLock();
  if (!sessionLock.tryLock(5000))
    throw Error(
      "ระบบกำลังบันทึกข้อมูลอื่น กรุณาลองเข้าสู่ระบบอีกครั้งในอีกสักครู่",
    );
  try {
    delete MEM.Users;
    delete MEM.Students;
    delete MEM.Groups;
    const latest = get_("Users", user.id);
    if (
      latest.status !== "active" ||
      Number(latest.version) !== Number(user.version)
    )
      throw Error("บัญชีเปลี่ยนแปลงแล้ว กรุณาเข้าสู่ระบบอีกครั้ง");
    if (latest.role !== "teacher") {
      studentRoomAccess_(latest.id);
      if (maintenance_()) throw Error("ระบบปิดให้นักเรียนเข้าใช้งานชั่วคราว");
    }
    batch_("Sessions", [
      {
        id: digest_(token),
        userId: user.id,
        version: user.version,
        expiresAt,
        lastSeenAt: Date.now(),
      },
    ]);
    if (user.role === "student")
      writeOne_("Users", {
        id: user.id,
        lastLoginAt: Date.now(),
        lastSeenAt: Date.now(),
        loginHistoryKnown: true,
        hasLoggedIn: true,
      });
    SpreadsheetApp.flush();
  } finally {
    sessionLock.releaseLock();
  }
  return {
    token,
    username: user.username,
    loginUsername: text_(q.username),
    userId: user.id,
    role: user.role,
    fullName: user.fullName,
    imgUrl: "",
    sessionPolicy: "idle-v1",
    idleTimeoutMs: sessionIdleMs_(user.role),
    expiresAt,
    serverNow: Date.now(),
  };
}

function sessionIdleMs_(role) {
  return role === "teacher" ? 3600000 : 900000;
}
function adminAuthError_(message, reason = "") {
  const error = Error(message);
  error.code = "AUTH_EXPIRED";
  error.authReason = reason;
  return error;
}
function sessionInfo_(q, touch) {
  const user = auth_(q);
  const id = digest_(q.token);
  delete MEM.Sessions;
  const session = findRow_("Sessions", id);
  if (!session || Number(session.expiresAt) <= Date.now())
    throw adminAuthError_(
      "ไม่มีการใช้งานนานหรือเซสชันถูกยกเลิก กรุณาเข้าสู่ระบบใหม่",
      "IDLE_EXPIRED",
    );
  let expiresAt = Number(session.expiresAt);
  if (touch) {
    expiresAt = Date.now() + sessionIdleMs_(user.role);
    const renewed = writeOne_("Sessions", {
      id,
      expiresAt,
      lastSeenAt: Date.now(),
    });
    SpreadsheetApp.flush();
    CacheService.getScriptCache().put(
      "kv_s_" + id,
      JSON.stringify(renewed),
      120,
    );
  }
  return {
    expiresAt,
    serverNow: Date.now(),
    idleTimeoutMs: sessionIdleMs_(user.role),
  };
}

function diagnosticOriginal_auth_(q, role) {
  if (MEM.$auth && MEM.$auth.token === q.token) {
    if (role && MEM.$auth.user.role !== role)
      throw adminAuthError_("ไม่มีสิทธิ์ใช้งาน");
    return MEM.$auth.user;
  }
  const token = text_(q.token);
  if (!token) throw adminAuthError_("กรุณาเข้าสู่ระบบจาก index.html");
  const id = digest_(token),
    cache = CacheService.getScriptCache();
  let session = json_(cache.get("kv_s_" + id), null);
  if (!session) {
    session = findRow_("Sessions", id);
    if (session) cache.put("kv_s_" + id, JSON.stringify(session), 120);
  }
  if (!session)
    throw adminAuthError_(
      "ไม่พบเซสชันนี้หรือถูกยกเลิก กรุณาเข้าสู่ระบบใหม่",
      "SESSION_NOT_FOUND",
    );
  if (Number(session.expiresAt) <= Date.now())
    throw adminAuthError_(
      "ไม่มีการใช้งานนาน เซสชันหมดอายุ กรุณาเข้าสู่ระบบใหม่",
      "IDLE_EXPIRED",
    );
  const user = findRow_("Users", session.userId);
  if (!user)
    throw adminAuthError_(
      "บัญชีนี้ถูกนำออกจากระบบแล้ว กรุณาติดต่อครู",
      "ACCOUNT_NOT_FOUND",
    );
  if (
    user.status !== "active" ||
    Number(user.version) !== Number(session.version) ||
    (role && user.role !== role)
  )
    throw adminAuthError_(
      "เซสชันถูกยกเลิกหรือไม่มีสิทธิ์ใช้งาน กรุณาเข้าสู่ระบบใหม่",
    );
  if (user.role !== "teacher") {
    try {
      studentRoomAccess_(user.id);
    } catch (error) {
      throw adminAuthError_(error.message, "ACCESS_DISABLED");
    }
  }
  if (user.role !== "teacher" && maintenance_())
    throw adminAuthError_(
      "ระบบปิดให้นักเรียนเข้าใช้งานชั่วคราว",
      "ACCESS_DISABLED",
    );
  MEM.$auth = { token: q.token, user };
  return user;
}

function teacher_(q) {
  return auth_(q, "teacher");
}
function enrollment_(studentId, offeringId) {
  const offering = get_("Offerings", offeringId),
    course = get_("Courses", offering.courseId);
