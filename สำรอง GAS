function dashboardData_(q) {
  const courses = new Map(
    rows_("Courses")
      .filter((c) => c.status === "active")
      .map((c) => [c.id, c]),
  );
  const groups = new Map(
    rows_("Groups")
      .filter((g) => g.status !== "inactive")
      .map((g) => [g.id, g]),
  );
  const students = new Map(
    rows_("Students")
      .filter((s) => s.status === "active" && groups.has(s.groupId))
      .map((s) => [s.id, s]),
  );
  const offerings = rows_("Offerings").filter(
    (o) =>
      o.status === "active" &&
      courses.has(o.courseId) &&
      (!q.courseId || o.courseId === q.courseId) &&
      (!q.offeringId || o.id === q.offeringId),
  );
  const offeringIds = new Set(offerings.map((o) => o.id));
  const courseByOffering = new Map(offerings.map((o) => [o.id, o.courseId]));
  const chapters = new Map(
    rows_("Chapters")
      .filter((c) => c.status === "active")
      .map((c) => [c.id, c.courseId]),
  );
  const activities = dashboardRows_("Activities", [
    "id",
    "chapterId",
    "title",
    "kind",
    "mode",
    "seconds",
    "showAnswers",
    "status",
    "dueAt",
  ]).filter((a) => a.status === "active" && chapters.has(a.chapterId));
  const tasksByCourse = new Map();
  activities.forEach((a) => {
    const courseId = chapters.get(a.chapterId);
    if (!tasksByCourse.has(courseId)) tasksByCourse.set(courseId, []);
    tasksByCourse.get(courseId).push(a);
  });
  const latest = new Map();
  dashboardRows_("Submissions", [
    "id",
    "activityId",
    "offeringId",
    "studentId",
    "status",
    "revision",
    "updatedAt",
  ])
    .filter(
      (s) =>
        offeringIds.has(s.offeringId) &&
        ["pending", "graded", "returned"].includes(s.status),
    )
    .forEach((s) => {
      const key = s.offeringId + ":" + s.studentId + ":" + s.activityId;
      const old = latest.get(key);
      if (!old || String(s.updatedAt) > String(old.updatedAt))
        latest.set(key, s);
    });
  const members = rows_("Enrollments").filter(
    (e) =>
      e.status === "active" &&
      offeringIds.has(e.offeringId) &&
      students.has(e.studentId) &&
      (!q.groupId || students.get(e.studentId).groupId === q.groupId),
  );
  const distinct = new Set(),
    progress = [],
    pending = { total: 0, items: [] },
    breakdown = new Map(),
    waiting = [],
    overdue = [],
    upcoming = new Map();
  const assignedActivityIds = new Set();
  let expected = 0,
    submitted = 0,
    graded = 0,
    returned = 0;
  members.forEach((e) => {
    const student = students.get(e.studentId),
      courseId = courseByOffering.get(e.offeringId),
      course = courses.get(courseId),
      group = groups.get(student.groupId);
    const key = e.offeringId + ":" + e.studentId;
    if (distinct.has(key)) return;
    distinct.add(key);
    const tasks = tasksByCourse.get(courseId) || [];
    let done = 0,
      pendingCount = 0,
      missing = 0,
      late = 0;
    const bucketKey = courseId + ":" + student.groupId;
    if (!breakdown.has(bucketKey))
      breakdown.set(bucketKey, {
        courseId,
        groupId: group.id,
        courseName: course.name,
        groupName: group.name,
        expected: 0,
        submitted: 0,
        graded: 0,
        returned: 0,
        pending: 0,
        missing: 0,
        students: new Set(),
      });
    const bucket = breakdown.get(bucketKey);
    bucket.students.add(student.id);
    tasks.forEach((a) => {
      assignedActivityIds.add(a.id);
      expected++;
      bucket.expected++;
      const work = latest.get(e.offeringId + ":" + e.studentId + ":" + a.id);
      const due = a.dueAt ? new Date(a.dueAt).getTime() : 0;
      if (work) {
        done++;
        submitted++;
        bucket.submitted++;
        if (work.status === "graded") {
          graded++;
          bucket.graded++;
        } else if (work.status === "returned") {
          returned++;
          bucket.returned++;
        } else {
          pendingCount++;
          bucket.pending++;
          pending.total++;
          pending.items.push({
            id: work.id,
            studentId: student.id,
            studentName: student.fullName,
            activityTitle: a.title,
            courseName: course.name,
            groupId: group.id,
            offeringId: e.offeringId,
            updatedAt: work.updatedAt,
          });
        }
      } else {
        missing++;
        bucket.missing++;
        const item = {
          studentId: student.id,
          name: student.fullName,
          groupId: group.id,
          offeringId: e.offeringId,
          courseName: course.name,
          title: a.title,
          dueAt: a.dueAt || "",
        };
        if (due && due < Date.now()) {
          late++;
          overdue.push(item);
        } else waiting.push(item);
      }
      if (due >= Date.now() && due <= Date.now() + 604800000) {
        const ukey = e.offeringId + ":" + group.id + ":" + a.id;
        if (!upcoming.has(ukey))
          upcoming.set(ukey, {
            title: a.title,
            courseName: course.name,
            groupId: group.id,
            dueAt: a.dueAt,
            expected: 0,
            submitted: 0,
          });
        const item = upcoming.get(ukey);
        item.expected++;
        if (work) item.submitted++;
      }
    });
    progress.push({
      studentId: student.id,
      name: student.fullName,
      groupId: group.id,
      offeringId: e.offeringId,
      courseId,
      done,
      total: tasks.length,
      percent: tasks.length ? Math.round((done / tasks.length) * 100) : 0,
      missing,
      overdue: late,
      pending: pendingCount,
    });
  });
  pending.items.sort((a, b) =>
    String(a.updatedAt).localeCompare(String(b.updatedAt)),
  );
  const buckets = Array.from(breakdown.values()).map((b) =>
    Object.assign({}, b, { students: b.students.size }),
  );
  const begun = new Set(
    buckets
      .filter((b) => b.submitted > 0)
      .map((b) => b.courseId + ":" + b.groupId),
  );
  const startedWaiting = waiting.filter((w) =>
    begun.has(courseByOffering.get(w.offeringId) + ":" + w.groupId),
  );
  return {
    progress,
    pending: { total: pending.total, items: pending.items.slice(0, 50) },
    totals: {
      activities: assignedActivityIds.size,
      overdue: overdue.length,
      expected,
      submitted,
      graded,
      returned,
      pending: pending.total,
      missing: expected - submitted,
      learners: new Set(members.map((e) => e.studentId)).size,
    },
    breakdown: buckets,
    followup: overdue.sort((a, b) =>
      String(a.dueAt).localeCompare(String(b.dueAt)),
    ),
    waiting: startedWaiting,
    upcoming: Array.from(upcoming.values()).sort((a, b) =>
      String(a.dueAt).localeCompare(String(b.dueAt)),
    ),
    updatedAt: new Date().toISOString(),
  };
}

