function importStudents_(q) {
  teacher_(q);
  if (
    !Array.isArray(q.students) ||
    !q.students.length ||
    q.students.length > 100
  )
    throw Error("นำเข้าครั้งละ 1–100 คน");
  const seen = new Set();
  const data = q.students.map((s) => {
    const d = studentData_(s, "");
    if (seen.has(studentNameKey_(d.username)))
      throw Error("ชื่อซ้ำในรายการนำเข้า: " + d.username);
    seen.add(studentNameKey_(d.username));
    return d;
  });
  const props = PropertiesService.getScriptProperties();
  let next = Math.max(
    Number(props.getProperty("KV_STD_SEQUENCE")) || 0,
    rows_("Students").reduce(
      (n, s) => Math.max(n, Number(String(s.id).replace("STD", "")) || 0),
      0,
    ),
  );
  const students = [],
    users = [];
  data.forEach((d) => {
    const id = "STD" + String(++next).padStart(3, "0");
    users.push({
      id,
      username: d.username,
      password: hash_("12345678"),
      role: "student",
      status: "active",
      fullName: d.fullName,
      version: 1,
      loginHistoryKnown: true,
    });
    delete d.username;
    students.push(Object.assign({ id }, d));
  });
  props.setProperty("KV_STD_SEQUENCE", String(next));
  batch_("Users", users);
  batch_("Students", students);
  return { count: students.length, studentIds: students.map((s) => s.id) };
}

function replaceRosterPreview_(q) {
  teacher_(q);
  const group = get_("Groups", q.groupId);
  if (group.status !== "active")
    throw Error("เปิดใช้งานห้องก่อนเปลี่ยนรายชื่อ");
  if (
    !Array.isArray(q.students) ||
    !q.students.length ||
    q.students.length > 100
  )
    throw Error("รายชื่อใหม่ต้องมี 1–100 คน");
  const seen = new Set();
  const students = q.students.map((s) => {
    const d = studentData_(Object.assign({}, s, { groupId: group.id }), "");
    if (seen.has(studentNameKey_(d.username))) throw Error("ชื่อซ้ำในรายการ: " + d.username);
    seen.add(studentNameKey_(d.username));
    return d;
  });
  const outgoing = rows_("Students").filter((s) => s.groupId === group.id);
  const ids = new Set(outgoing.map((s) => s.id));
  const accounts = rows_("Users").filter((u) => ids.has(u.id));
  const enrollments = rows_("Enrollments").filter((e) => ids.has(e.studentId));
  const submissions = rows_("Submissions").filter((e) => ids.has(e.studentId));
  const submissionIds = new Set(submissions.map((s) => s.id));
  const related = {};
  ["Progress", "Runs", "Profiles", "Sessions", "History"].forEach((key) => {
    related[key] = rows_(key).filter((r) => key === "History" ? submissionIds.has(r.submissionId) :
      key === "Profiles" ? ids.has(r.id) : key === "Sessions" ? ids.has(r.userId) : ids.has(r.studentId));
  });
  const fingerprint = digest_(JSON.stringify({ group, students, outgoing, accounts, enrollments, submissions, related }));
  return {
    groupName: group.name,
    outgoing: outgoing.map((s) => ({ id: s.id, name: s.fullName })),
    incoming: students.map((s) => s.fullName),
    enrollmentCount: enrollments.filter((e) => e.status === "active").length,
    submissionCount: submissions.length,
    progressCount: related.Progress.length,
    runCount: related.Runs.length,
    historyCount: related.History.length,
    profileCount: related.Profiles.length,
    sessionCount: related.Sessions.length,
    fingerprint,
  };
}
function replaceRoster_(q) {
  const preview = replaceRosterPreview_(q);
  if (q.confirmText !== "เปลี่ยนรายชื่อ")
    throw Error("พิมพ์ เปลี่ยนรายชื่อ ให้ตรงก่อนดำเนินการ");
  if (q.fingerprint !== preview.fingerprint)
    throw Error("ข้อมูลเปลี่ยนแล้ว กรุณาตรวจผลกระทบใหม่");
  const backup = backup_(q);
  const ids = new Set(preview.outgoing.map((s) => s.id));
  const submissionIds = new Set(rows_("Submissions").filter((r) => ids.has(r.studentId)).map((r) => r.id));
  const removedSessions = rows_("Sessions").filter((r) => ids.has(r.userId));
  removedSessions.forEach((r) => CacheService.getScriptCache().remove("kv_s_" + r.id));
  rewriteRows_("History", rows_("History").filter((r) => !submissionIds.has(r.submissionId)));
  ["Enrollments", "Submissions", "Progress", "Runs"].forEach((key) => {
    rewriteRows_(key, rows_(key).filter((r) => !ids.has(r.studentId)));
  });
  rewriteRows_("Sessions", rows_("Sessions").filter((r) => !ids.has(r.userId)));
  ["Profiles", "Users", "Students"].forEach((key) => {
    rewriteRows_(key, rows_(key).filter((r) => !ids.has(r.id)));
  });
  const result = importStudents_(
    Object.assign({}, q, {
      students: q.students.map((s) =>
        Object.assign({}, s, { groupId: q.groupId }),
      ),
    }),
  );
  return { count: result.count, deleted: ids.size, deletedSubmissions: preview.submissionCount, backupUrl: backup.url };
}

