function progressData_(q) {
  const o = get_("Offerings", q.offeringId);
  const chapters = new Set(
    rows_("Chapters")
      .filter((c) => c.courseId === o.courseId && c.status === "active")
      .map((c) => c.id),
  );
  const materials = rows_("Materials").filter(
    (m) =>
      chapters.has(m.chapterId) &&
      m.status === "active" &&
      m.kind === "knowledge",
  );
  const activities = rows_("Activities").filter(
    (a) => chapters.has(a.chapterId) && a.status === "active",
  );
  const aids = new Set(activities.map((a) => a.id)),
    mids = new Set(materials.map((m) => m.id));
  const submissions = rows_("Submissions").filter(
    (s) => s.offeringId === q.offeringId && aids.has(s.activityId),
  );
  const reads = rows_("Progress").filter(
    (r) => r.offeringId === q.offeringId && mids.has(r.materialId),
  );
  const students = new Map(rows_("Students").map((s) => [s.id, s]));
  const total = materials.length + activities.length;
  const scoredActivityIds = new Set(
    activities
      .filter((a) =>
        a.countScore === "" ? a.mode !== "game" : a.countScore === true,
      )
      .map((a) => a.id),
  );
  const workByStudent = new Map(),
    readsByStudent = new Map();
  submissions.forEach((s) => {
    if (!workByStudent.has(s.studentId)) workByStudent.set(s.studentId, []);
    workByStudent.get(s.studentId).push(s);
  });
  reads.forEach((r) => {
    if (!readsByStudent.has(r.studentId)) readsByStudent.set(r.studentId, []);
    readsByStudent.get(r.studentId).push(r);
  });
  return rows_("Enrollments")
    .filter(
      (e) =>
        e.offeringId === q.offeringId &&
        e.status === "active" &&
        (!q.groupId ||
          ((students.get(e.studentId) || {}).groupId || e.groupId) ===
          q.groupId),
    )
    .map((e) => {
      const work = workByStudent.get(e.studentId) || [],
        read = readsByStudent.get(e.studentId) || [];
      const submittedIds = new Set(work.map((w) => w.activityId));
      const done =
        submittedIds.size + new Set(read.map((r) => r.materialId)).size;
      const graded = work.filter(
        (s) => s.status === "graded" && scoredActivityIds.has(s.activityId),
      );
      return {
        studentId: e.studentId,
        name: (students.get(e.studentId) || {}).fullName || e.studentId,
        groupId: (students.get(e.studentId) || {}).groupId || e.groupId,
        expected: activities.length,
        submitted: submittedIds.size,
        returned: work.filter((s) => s.status === "returned").length,
        graded: work.filter((s) => s.status === "graded").length,
        missing: activities.filter((a) => !submittedIds.has(a.id)).length,
        readCount: new Set(read.map((r) => r.materialId)).size,
        materialCount: materials.length,
        done,
        total,
        percent: total ? Math.round((done / total) * 100) : 0,
        pending: work.filter((s) => s.status === "pending").length,
        score: graded.reduce(
          (n, s) =>
            n + json_(s.scores, []).reduce((a, b) => a + Number(b || 0), 0),
          0,
        ),
        maxScore: graded.reduce(
          (n, s) =>
            n + json_(s.questionSnapshot, []).reduce((a, b) => a + b.points, 0),
          0,
        ),
      };
    });
}

