function cleanupLmsHistory() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(1000)) return;
  try {
    MEM = {};
    BOOK = null;
    const now = Date.now(),
      day = 86400000;
    const requests = rows_("Requests"),
      recent = requests.filter(
        (r) => now - new Date(r.updatedAt).getTime() <= 30 * day,
      );
    if (requests.length !== recent.length) rewriteRows_("Requests", recent);
    const expiredSessions = pruneExpiredSessions_(now);
    const history = rows_("AdminHistory");
    let changed = false,
      snapshotsRemoved = 0;
    history.forEach((r) => {
      const age = now - new Date(r.updatedAt).getTime();
      if (
        age > 90 * day &&
        r.status !== "pending" &&
        (r.snapshotFileId || r.snapshotJson)
      ) {
        try {
          if (r.snapshotFileId)
            DriveApp.getFileById(r.snapshotFileId).setTrashed(true);
          r.snapshotFileId = "";
          r.snapshotJson = "";
          changed = true;
          snapshotsRemoved++;
        } catch (_) { }
      }
    });
    const keep = history.filter(
      (r) =>
        r.status === "pending" ||
        r.snapshotFileId ||
        r.snapshotJson ||
        now - new Date(r.updatedAt).getTime() <= 180 * day,
    );
    if (changed || keep.length !== history.length)
      rewriteRows_("AdminHistory", keep);
    const report = {
      expiredSessions,
      requestsRemoved: requests.length - recent.length,
      historyRemoved: history.length - keep.length,
      snapshotsRemoved,
    };
    SpreadsheetApp.flush();
    PropertiesService.getScriptProperties().setProperties({
      KV_LAST_CLEANUP_AT: new Date().toISOString(),
      KV_LAST_CLEANUP_RESULT: JSON.stringify(report),
      KV_DATA_REVISION: Utilities.getUuid(),
    });
    return report;
  } finally {
    lock.releaseLock();
  }
}

