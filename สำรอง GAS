function saveProfile_(q) {
  const user = teacher_(q);
  const fullName = need_(q.fullName, "ชื่อที่แสดง", 150);
  const email = text_(q.email),
    phone = text_(q.phone);
  if (
    email.length > 150 ||
    (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email))
  )
    throw Error("อีเมลไม่ถูกต้อง");
  if (phone.length > 40) throw Error("เบอร์โทรยาวเกินไป");
  const old = rows_("Profiles").find((p) => p.id === user.id) || {};
  let avatarFileId = q.removeAvatar ? "" : old.avatarFileId || "";
  let avatarMime = q.removeAvatar ? "" : old.avatarMime || "";
  let created;
  if (q.avatar) {
    const mime = enum_(q.avatar.mime, [
      "image/jpeg",
      "image/png",
      "image/webp",
    ]);
    if (typeof q.avatar.data !== "string" || q.avatar.data.length > 80000)
      throw Error("รูปโปรไฟล์ใหญ่เกิน 60 KB หลังย่อ");
    const bytes = Utilities.base64Decode(q.avatar.data),
      b = bytes.map((n) => (n + 256) % 256);
    const valid =
      mime === "image/jpeg"
        ? b[0] === 255 && b[1] === 216 && b[2] === 255
        : mime === "image/png"
          ? b.slice(0, 8).join(",") === "137,80,78,71,13,10,26,10"
          : b.slice(0, 4).join(",") === "82,73,70,70" &&
          b.slice(8, 12).join(",") === "87,69,66,80";
    if (!valid || bytes.length > 60000)
      throw Error("ไฟล์รูปไม่ถูกต้อง หรือใหญ่เกินกำหนด");
    const root = DriveApp.getFolderById(
      PropertiesService.getScriptProperties().getProperty("KV_DRIVE_FOLDER_ID"),
    );
    const folders = root.getFoldersByName("Profiles");
    const folder = folders.hasNext()
      ? folders.next()
      : root.createFolder("Profiles");
    created = folder.createFile(
      Utilities.newBlob(
        bytes,
        mime,
        user.id +
        "-" +
        Utilities.getUuid() +
        "." +
        (mime === "image/jpeg" ? "jpg" : mime.split("/")[1]),
      ),
    );
    try {
      created.setSharing(
        DriveApp.Access.ANYONE_WITH_LINK,
        DriveApp.Permission.VIEW,
      );
    } catch (error) {
      try {
        created.setTrashed(true);
      } catch (_) { }
      throw Error(
        "แชร์รูปโปรไฟล์เพื่อแสดงบนเว็บไม่ได้ รูปเดิมยังคงอยู่ กรุณาตรวจนโยบาย Drive",
      );
    }
    avatarFileId = created.getId();
    avatarMime = mime;
  }
  try {
    write_("Users", { id: user.id, fullName });
    write_("Profiles", { id: user.id, email, phone, avatarFileId, avatarMime });
  } catch (err) {
    if (created) created.setTrashed(true);
    throw err;
  }
  let cleanupWarning = "";
  if (old.avatarFileId && old.avatarFileId !== avatarFileId) {
    CacheService.getScriptCache().remove("kv_avatar_" + old.avatarFileId);
    try {
      DriveApp.getFileById(old.avatarFileId).setTrashed(true);
    } catch (err) {
      cleanupWarning = "บันทึกแล้ว แต่ย้ายรูปเก่าลงถังขยะไม่สำเร็จ";
    }
  }
  return Object.assign(profile_(q), { cleanupWarning });
}

