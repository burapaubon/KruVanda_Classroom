    rows_("Students").some((s) => s.id !== id && studentNameKey_(s.firstName + " " + s.lastName) === key)) {
    const error = Error("ห้ามเพิ่มนักเรียนซ้ำ: " + firstName + " " + lastName + " — มีชื่อนี้ในระบบแล้ว กรุณาใช้บัญชีเดิมหรือย้ายชั้นเรียน");
