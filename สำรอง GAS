    0,
  );
  const next =
    Math.max(highest, Number(props.getProperty("KV_STD_SEQUENCE")) || 0) + 1;
  const id = q.id || "STD" + String(next).padStart(3, "0");
  if (!q.id) props.setProperty("KV_STD_SEQUENCE", String(next));
  const account = old ? get_("Users", id) : null;
  write_("Users", {
    id,
