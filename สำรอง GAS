function adminRestoreState_(saved, before, keys) {
  const teachers = before.Users.filter((u) => u.role === "teacher"),
    ids = new Set(teachers.map((u) => u.id)),
    versions = new Map(before.Users.map((u) => [u.id, Number(u.version || 0)]));
  const desired = {};
  ADMIN_TABLES.forEach(
    (k) => (desired[k] = keys.includes(k) ? saved[k] : before[k]),
  );
  if (keys.includes("Users"))
    desired.Users = teachers.concat(
      saved.Users.filter((u) => u.role !== "teacher").map((u) =>
        Object.assign({}, u, {
          version:
            Math.max(Number(u.version || 0), versions.get(u.id) || 0) + 1,
        }),
      ),
    );
  if (keys.includes("Profiles"))
    desired.Profiles = before.Profiles.filter((p) => ids.has(p.id)).concat(
      saved.Profiles.filter((p) => !ids.has(p.id)),
    );
  validateRestore_(desired);
  return desired;
}
