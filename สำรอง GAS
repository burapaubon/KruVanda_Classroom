function adminUndo_(q) {
  const actor = teacher_(q);
  adminReady_();
  if (q.confirmText !== "ยืนยัน") throw Error("พิมพ์ ยืนยัน ก่อนย้อนรายการ");
  const preview = adminUndoPreview_(q);
  if (preview.conflicts || preview.fingerprint !== q.fingerprint)
    throw Error(
      "ข้อมูลที่เกี่ยวข้องเปลี่ยนภายหลังแล้ว ระบบหยุดเพื่อไม่ทับข้อมูลใหม่",
    );
  const data = adminPatchData_(q),
    backup = adminBackup_(q);
  const keys = [
    ...new Set(
      data.patches.filter((p) => p.key !== "$maintenance").map((p) => p.key),
    ),
  ],
    before = adminState_(keys),
    desired = {};
  keys.forEach((key) => {
    const map = new Map(before[key].map((r) => [r.id, r]));
    data.patches
      .filter((p) => p.key === key)
      .forEach((p) => {
        if (p.before) {
          const row = Object.assign({}, p.before);
          if (key === "Users" && row.role !== "teacher")
            row.version =
              Math.max(
                Number(row.version || 0),
                Number(map.get(p.id)?.version || 0),
              ) + 1;
          map.set(p.id, row);
        } else map.delete(p.id);
      });
    desired[key] = Array.from(map.values());
  });
  const props = PropertiesService.getScriptProperties();
  props.setProperty("LMS_MAINTENANCE", "1");
  try {
    keys.forEach((key) => rewriteRows_(key, desired[key]));
  } catch (e) {
    let rollbackFailed = false;
    try {
      keys.forEach((key) => rewriteRows_(key, before[key]));
    } catch (_) {
      rollbackFailed = true;
      e.message += " · คืนค่าไม่ครบ กรุณากู้จากไฟล์สำรอง";
    }
    props.setProperty(
      "LMS_MAINTENANCE",
      rollbackFailed || before.maintenance ? "1" : "0",
    );
    throw e;
  }
  const setting = data.patches.find((p) => p.key === "$maintenance");
  props.setProperty(
    "LMS_MAINTENANCE",
    (setting ? setting.before : before.maintenance) ? "1" : "0",
  );
  if (keys.includes("Users")) {
    const users = new Map(rows_("Users").map((u) => [u.id, u])),
      removed = rows_("Sessions").filter(
        (s) =>
          !users.has(s.userId) ||
          Number(users.get(s.userId).version) !== Number(s.version),
      );
    const ids = new Set(removed.map((s) => s.id));
    if (ids.size)
      rewriteRows_(
        "Sessions",
        rows_("Sessions").filter((s) => !ids.has(s.id)),
      );
    ids.forEach((id) => CacheService.getScriptCache().remove("kv_s_" + id));
  }
  write_("AdminHistory", {
    id: q.id,
    status: "undone",
    message: "ย้อนรายการแล้ว",
  });
  write_("AdminHistory", {
    id: id_("AUD"),
    action: "adminUndo",
    target: data.event.target || "รายการเดิม",
    status: "success",
    updatedAt: new Date().toISOString(),
    changeCount: preview.total,
    message: "ย้อนรายการ: " + data.event.message + " · สำรองก่อนย้อนแล้ว",
    actor: actor.fullName || "ครู",
  });
  return { updated: true, backupUrl: backup.url };
}

