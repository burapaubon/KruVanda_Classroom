}
function adminManage_(q) {
  const preview = adminManagePreview_(q);
  if (q.confirmText !== preview.confirmText)
    throw Error("พิมพ์ " + preview.confirmText + " ให้ตรงก่อนดำเนินการ");
  if (q.fingerprint !== preview.fingerprint)
    throw Error("ข้อมูลเปลี่ยนแล้ว กรุณาตรวจผลกระทบอีกครั้ง");
  const plan = adminPlan_(q);
  if (!plan.count) return { updated: true, count: 0 };
  if (q.target === "sessions") {
    const ids = new Set(plan.sessionIds);
    rewriteRows_(
      "Sessions",
      rows_("Sessions").filter((s) => !ids.has(s.id)),
    );
    plan.sessionIds.forEach((id) =>
      CacheService.getScriptCache().remove("kv_s_" + id),
    );
    write_("AdminHistory", {
      id: id_("AUD"),
      action: "adminManage",
      target: "sessions:" + q.mode,
      status: "success",
      updatedAt: new Date().toISOString(),
      changeCount: ids.size,
      actor: teacher_(q).fullName,
      message: "จัดการเซสชัน " + ids.size + " รายการ",
    });
    return { updated: true, count: ids.size };
  }
  const destructive = ["delete", "clearWork", "reset"].includes(q.mode);
  const backup = destructive ? adminBackup_(q) : null;
  const props = PropertiesService.getScriptProperties(),
    previous = maintenance_();
  let rollbackFailed = false;
  if (destructive) props.setProperty("LMS_MAINTENANCE", "1");
  try {
    plan.keys
      .filter((k) => plan.patches.some((p) => p.key === k))
      .forEach((k) => rewriteRows_(k, plan.desired[k]));
    if (destructive || q.target === "students" || q.target === "groups") {
      const users = new Map(rows_("Users").map((u) => [u.id, u]));
      const revokeAll = q.mode === "reset";
      const removed = rows_("Sessions").filter((s) => {
        const u = users.get(s.userId);
        return (
          !u ||
          (u.role !== "teacher" &&
            (revokeAll ||
              Number(s.version) !== Number(u.version) ||
              u.status !== "active"))
        );
      });
      const ids = new Set(removed.map((s) => s.id));
      if (ids.size)
        rewriteRows_(
          "Sessions",
          rows_("Sessions").filter((s) => !ids.has(s.id)),
        );
      ids.forEach((id) => CacheService.getScriptCache().remove("kv_s_" + id));
    }
  } catch (e) {
    try {
      plan.keys.forEach((k) => rewriteRows_(k, plan.before[k]));
    } catch (_) {
      rollbackFailed = true;
      e.message +=
        " · คืนค่าอัตโนมัติไม่ครบ ระบบปิดให้นักเรียนเข้าใช้งาน กรุณากู้จากไฟล์สำรอง";
    }
    throw e;
  } finally {
    if (destructive)
      props.setProperty(
        "LMS_MAINTENANCE",
        q.mode === "reset" || rollbackFailed ? "1" : previous ? "1" : "0",
      );
  }
  return {
    updated: true,
    count: plan.count,
    backupUrl: backup ? backup.url : "",
  };
}

function adminTarget_(q, patches) {
  if (q.action === "adminManage") {
    if (q.target === "work")
      return [
        q.courseId ? get_("Courses", q.courseId).name : "ทุกรายวิชา",
        q.groupId ? get_("Groups", q.groupId).name : "ทุกชั้นเรียน",
        q.studentId ? get_("Students", q.studentId).fullName : "นักเรียนทุกคน",
        q.activityId ? get_("Activities", q.activityId).title : "ทุกกิจกรรม",
      ].join(" · ");
    const key = { courses: "Courses", groups: "Groups", students: "Students" }[
      q.target
    ];
    if (!key)
      return q.target === "system" ? "ข้อมูลทั้งระบบ" : "เซสชันนักเรียน";
    const selected = patches
      .filter((p) => p.key === key)
      .map((p) => (p.after || p.before).fullName || (p.after || p.before).name);
    return (
      selected.slice(0, 3).join(", ") +
      (selected.length > 3
        ? " และอีก " + (selected.length - 3) + " รายการ"
        : "")
    );
  }
  const scopes = {
    saveGroup: "Groups",
    deleteGroup: "Groups",
    saveStudent: "Students",
    saveCourse: "Courses",
    saveChapter: "Chapters",
    saveMaterial: "Materials",
    deleteMaterial: "Materials",
    saveActivity: "Activities",
    resetPassword: "Users",
    grade: "Submissions",
    returnWork: "Submissions",
  };
  const key =
    q.action === "setStatus"
      ? q.entity
      : q.action === "deleteEntity"
        ? q.kind === "course"
          ? "Courses"
          : "Students"
        : scopes[q.action];
  const patch = patches.find((p) => p.key === key && (!q.id || p.id === q.id));
  const row = patch && (patch.after || patch.before);
  if (key === "Submissions" && row) {
    const student = rows_("Students").find((s) => s.id === row.studentId),
      activity = rows_("Activities").find((a) => a.id === row.activityId);
    return (
      (student ? student.fullName : "นักเรียน") +
      " · " +
      (activity ? activity.title : "กิจกรรม")
    );
  }
  return row
    ? row.fullName || row.name || row.title || q.target || ""
    : q.action === "promote"
      ? get_("Groups", q.fromId).name + " → " + get_("Groups", q.toId).name
      : q.target || "";
}
