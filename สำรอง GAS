function adminDiff_(before, after, keys) {
  const patches = [];
  keys.forEach((key) => {
    const old = new Map(before[key].map((r) => [r.id, r])),
      current = new Map(after[key].map((r) => [r.id, r]));
    new Set([...old.keys(), ...current.keys()]).forEach((id) => {
      const a = old.get(id) || null,
        b = current.get(id) || null;
      if (JSON.stringify(a) !== JSON.stringify(b))
        patches.push({ key, id, before: a, after: b });
    });
  });
  if (before.maintenance !== after.maintenance)
    patches.push({
      key: "$maintenance",
      id: "maintenance",
      before: before.maintenance,
      after: after.maintenance,
    });
  return patches;
}

